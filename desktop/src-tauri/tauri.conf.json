{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Promview",
  "version": "0.1.0",
  "identifier": "ca.cropa.promview",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "console",
        "title": "Promview",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "visible": true,
        "resizable": true
      },
      {
        "label": "compact",
        "title": "Promview alerts",
        "width": 420,
        "height": 560,
        "visible": false,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Operational console for Prometheus Alertmanager alerts"
  }
}
