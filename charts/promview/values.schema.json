{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "database",
    "auth",
    "service"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "pullSecrets": {
          "type": "array"
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "existingSecret",
        "urlKey"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "urlKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "auth": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "open",
            "oidc"
          ]
        }
      }
    },
    "bootstrapSource": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "slug": {
          "type": "string",
          "anyOf": [
            {
              "maxLength": 0
            },
            {
              "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "tokenKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "roleBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role",
          "oidcIssuer",
          "oidcGroup"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "viewer",
              "operator",
              "administrator"
            ]
          },
          "oidcIssuer": {
            "type": "string",
            "minLength": 1
          },
          "oidcGroup": {
            "type": "string",
            "minLength": 1
          },
          "selectors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "type",
        "port"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "alertExpiry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "staleAfter": {
          "type": "string",
          "pattern": "^([0-9]+(ns|us|ms|s|m|h))+$|^0$"
        },
        "interval": {
          "type": "string",
          "pattern": "^([0-9]+(ns|us|ms|s|m|h))+$"
        }
      }
    }
  }
}
